[Unit]
Description=UI Design Editor Space saves
After=network.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/uidesigneditor
ExecStart=/usr/bin/node /opt/uidesigneditor/server/index.mjs
Environment=PORT=3000
Environment=PUBLIC_DIR=/srv/uidesigneditor
Environment=DATA_DIR=/var/lib/uidesigneditor
StateDirectory=uidesigneditor
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
