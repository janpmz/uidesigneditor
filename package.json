{
  "name": "uidesigneditor",
  "version": "0.1.0",
  "private": true,
  "description": "A small visual editor for quick screen drafts.",
  "scripts": {
    "start": "python3 -m http.server 3000 --bind 127.0.0.1 --directory .",
    "sync-site": "node scripts/sync-site.mjs",
    "build": "npm run sync-images && npm run sync-site && node scripts/build-site.mjs",
    "sync-images": "node scripts/sync-images.mjs",
    "test": "node --test drafts/resize.test.cjs drafts/dark-library-layout/editor.test.cjs drafts/dark-chapter-layout/selection.test.cjs editor/*.test.cjs tests/*.test.cjs"
  }
}
